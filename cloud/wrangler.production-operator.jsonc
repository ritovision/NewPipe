    "FENCE_RESOURCE": "902ad132-225c-42a8-a725-6122bb1f4dcc",
    "SCOPE": "{\"account\":\"b35814b119cba4448e3e0ac59442cc25\",\"worker\":\"newpipe-prod-v1\",\"database\":\"4ab5e6b2-0496-4833-ae0e-31834f385b8c\",\"bucket\":\"newpipe-prod-v1\",\"library\":\"newpipe-prod-library-821d08da-9738-4d3e-aaa4-99285148e63e\",\"generation\":\"d9d34eb2-09ed-411a-9700-a320fe237f9b\",\"fence\":{\"control\":\"9824bf18-e614-491e-b408-335f958bdf22\",\"resource\":\"902ad132-225c-42a8-a725-6122bb1f4dcc\",\"operator\":\"newpipe-prod-v1-op\"}}"
  }
}
