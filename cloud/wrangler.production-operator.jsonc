// Explicit production maintenance/recovery operator. OPERATOR_TOKEN is a Cloudflare secret; not stored here.
{
  "account_id": "b35814b119cba4448e3e0ac59442cc25",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newpipe-prod-v1",
      "database_id": "4ab5e6b2-0496-4833-ae0e-31834f385b8c",
      "migrations_dir": "migrations"
    },
    {
      "binding": "CONTROL",
      "database_name": "newpipe-prod-v1-ctl",
      "database_id": "9824bf18-e614-491e-b408-335f958bdf22",
      "migrations_dir": "control-migrations"
    }
  ],
  "r2_buckets": [
    {
